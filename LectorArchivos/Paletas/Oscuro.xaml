<!-- Colores propios de la aplicación en modo oscuro (los controles usan el tema Fluent de WPF). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B4B4B4" />
    <SolidColorBrush x:Key="SectionTitleBrush" Color="#8DB8F0" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#F0C060" />
    <SolidColorBrush x:Key="BarFillBrush" Color="#3D6FA8" />
    <SolidColorBrush x:Key="BarTrackBrush" Color="#333A44" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#353535" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#2F4A6B" />
</ResourceDictionary>
