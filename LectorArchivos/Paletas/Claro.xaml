<!-- Colores propios de la aplicación en modo claro (los controles usan el tema Fluent de WPF). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D0D4DA" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="SectionTitleBrush" Color="#1F3A5F" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="BarFillBrush" Color="#7FA7D9" />
    <SolidColorBrush x:Key="BarTrackBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#D6E4F5" />
</ResourceDictionary>
