<Window x:Class="LectorArchivos.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar IA (Google Gemini)" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            El resumen de cada archivo se obtiene con Google Gemini usando búsqueda en Google.
            Crea una API key gratuita en
            <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="Hyperlink_RequestNavigate">aistudio.google.com/apikey</Hyperlink>.
        </TextBlock>

        <TextBlock Text="API key" FontWeight="SemiBold" />
        <PasswordBox x:Name="ApiKeyBox" Height="28" Margin="0,4,0,2" VerticalContentAlignment="Center" />
        <TextBlock x:Name="ApiKeyHint" Foreground="#666" FontSize="12" TextWrapping="Wrap" />

        <TextBlock Text="Modelo" FontWeight="SemiBold" Margin="0,12,0,0" />
        <TextBox x:Name="ModelBox" Height="28" Margin="0,4,0,2" VerticalContentAlignment="Center" />
        <TextBlock Foreground="#666" FontSize="12" TextWrapping="Wrap"
                   Text="Por defecto «gemini-flash-latest» (rápido y con nivel gratuito). Puedes usar cualquier modelo Gemini que admita la herramienta google_search." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Guardar" Width="90" Height="28" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancelar" Width="90" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
